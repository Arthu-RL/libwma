@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find dependencies that 'wma' exposes publicly
find_dependency(ink REQUIRED)
if(@WMA_ENABLE_SDL@)
    find_dependency(SDL2)
endif()
if(@WMA_ENABLE_GLFW@)
    find_dependency(glfw3)
endif()
if(@WMA_ENABLE_X11@)
    find_dependency(X11)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/wma-targets.cmake")

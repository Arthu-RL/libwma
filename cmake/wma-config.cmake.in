@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(ink REQUIRED)

if(@WMA_ENABLE_SDL@)
    find_dependency(SDL2 REQUIRED)
endif()

if(@WMA_ENABLE_GLFW@)
    find_dependency(glfw3 REQUIRED)
endif()

if(@WMA_ENABLE_X11@)
    find_dependency(X11 REQUIRED)
endif()

if(@WMA_ENABLE_WAYLAND@)
    find_dependency(PkgConfig REQUIRED)

    pkg_check_modules(WAYLAND REQUIRED IMPORTED_TARGET
        wayland-client
        wayland-cursor
        xkbcommon
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/wma-targets.cmake")

check_required_components(wma)
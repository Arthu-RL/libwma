@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Every platform installed here shares one set of headers; the library and its
# dependency list differ. Resolve the caller's ABI tag with the code that
# produced the name, then load that build's own deps and targets.
include("${CMAKE_CURRENT_LIST_DIR}/PlatformSuffix.cmake")
wma_resolve_installed_suffix("${CMAKE_CURRENT_LIST_DIR}" "wma-targets" _wma_suffix)

set(_wma_deps    "${CMAKE_CURRENT_LIST_DIR}/wma-deps-${_wma_suffix}.cmake")
set(_wma_targets "${CMAKE_CURRENT_LIST_DIR}/wma-targets-${_wma_suffix}.cmake")

if(NOT EXISTS "${_wma_targets}")
    file(GLOB _wma_have "${CMAKE_CURRENT_LIST_DIR}/wma-targets-*.cmake")
    list(TRANSFORM _wma_have REPLACE "^.*/wma-targets-(.+)\\.cmake$" "\\1")
    list(FILTER _wma_have EXCLUDE REGEX "-(debug|release|relwithdebinfo|minsizerel)$")
    message(FATAL_ERROR "wma is not installed for '${_wma_suffix}'; have: ${_wma_have}")
endif()

include("${_wma_deps}")
include("${_wma_targets}")

unset(_wma_suffix)
unset(_wma_deps)
unset(_wma_targets)
unset(_wma_have)

check_required_components(wma)

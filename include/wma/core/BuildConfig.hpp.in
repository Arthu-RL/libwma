#ifndef WMA_CORE_BUILD_CONFIG_HPP
#define WMA_CORE_BUILD_CONFIG_HPP

//! Generated by CMake from BuildConfig.hpp.in — do not edit the generated copy.
//!
//! This is the ONLY place the set of compiled-in backends is exposed to
//! downstream code. The private WMA_ENABLE_* build macros are intentionally NOT
//! visible to consumers (they would drag backend SDK headers into user TUs), so
//! use these WMA_HAS_* feature macros for conditional compilation instead.

#define WMA_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define WMA_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define WMA_VERSION_PATCH @PROJECT_VERSION_PATCH@

#cmakedefine01 WMA_HAS_GLFW
#cmakedefine01 WMA_HAS_SDL
#cmakedefine01 WMA_HAS_X11
#cmakedefine01 WMA_HAS_WAYLAND

//! Audio backends. A separate axis from the windowing backends above: a window
//! opened through any of them can pair with any audio device. WMA_HAS_SDL
//! covers SDL3's audio half as well as its windowing half — one dependency,
//! two subsystems. There is no flag for the null audio device: it is always
//! compiled in, so AudioBackend::Null is unconditionally available.
#cmakedefine01 WMA_HAS_ALSA

//! Whether GraphicsAPI::Metal can be honoured by this build: an Apple target with
//! at least one backend that has a route to a CAMetalLayer (SDL3 anywhere, GLFW
//! on macOS). Unlike the four flags above this is not a straight copy of a
//! WMA_ENABLE_* option — it depends on the target platform too — so test this
//! rather than re-deriving it from __APPLE__ plus the backend list.
#cmakedefine01 WMA_HAS_METAL

#endif // WMA_CORE_BUILD_CONFIG_HPP
